# Copy this file to .env in the backend folder, then enter your local MySQL password.
DB_URL=jdbc:mysql://localhost:3306/sannhaminh_new?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD
SERVER_PORT=8080

# Replace with a private random secret (at least 32 characters).
JWT_SECRET=replace-this-with-a-private-random-secret-at-least-32-characters
JWT_EXPIRATION_HOURS=12

# Created only when the database has no ADMIN account. Change before first startup.
ADMIN_EMAIL=admin@sannhaminh.local
ADMIN_PASSWORD=ChangeThisAdminPassword123!
ADMIN_NAME=Quan tri vien

VNPAY_ENABLED=false
MOMO_ENABLED=false
